ENVIRONMENT=development
LOG_LEVEL=info
PORT=3000

# Data namespace. Changing this starts users from a clean Mongo/Search dataset while
# preserving the previous version for deliberate cleanup later.
DATA_VERSION=0.2.2

MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=peermate

# Chroma runs as a server; the JS client has no embedded mode.
# Which store answers a search. The cutover is staged, not switched:
#   chroma  write and read Chroma (where this started)
#   dual    write both, still read Chroma — backfill and compare under real traffic
#   atlas   read Atlas, stop writing Chroma; the container can then go
# See: npm run migrate-to-atlas
SEARCH_BACKEND=chroma

CHROMA_URL=http://localhost:8000

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=peermate-local
MINIO_SECRET_KEY=peermate-local-dev
MINIO_USE_SSL=false

# Baileys session credentials land here. Gitignored — never commit this directory.
# Which bot number this process is. One shard, one number, one auth directory —
# two processes against one auth state corrupt the WhatsApp session irrecoverably.
# Leave as "default" for a single-number deployment.
SHARD_ID=default

WHATSAPP_AUTH_DIR=./auth_state

OPENAI_API_KEY=

# Optional tracing and evaluation. Keep off unless student message and retrieved
# material may be sent to the configured LangSmith workspace.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=peermate

# Exa. Optional. Used only to find further reading for topics that already appear in
# the course files — never to answer a question or to set one.
EXA_API_KEY=

INGEST_CONCURRENCY=2


# Optional: pair with an 8-character code instead of a QR scan.
# Set to the bot number in full international form, e.g. 2348012345678
WHATSAPP_PAIRING_NUMBER=

# Public landing-page email signup. Google signup is intentionally disabled for now.
LANDING_WHATSAPP_NUMBER=15076046411

# SMTP delivery for landing-page signups. MAIL_FROM sends both messages:
# an operator notification to ADMIN_WAITLIST_EMAIL and a welcome email to the signup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=PeerMate <hello@example.com>
ADMIN_WAITLIST_EMAIL=

# Set to false while recording a demo. Alerts that arrive while a student is
# mid-conversation are normally held for a minute so they do not read as the answer
# to the question just asked — on camera that looks like an alert that never came.
DEFER_ALERTS=true

# The narrated video explainer. Off by default: it needs a render worker running
# (npm run worker) or a student is told a video is coming that nobody builds.
RENDER_VIDEO_ENABLED=false

# Optional renderer overrides. The defaults run render/src/cli.ts as an isolated
# subprocess. Livepeer/OpenAI credentials belong in render/.env for that process.
RENDER_CWD=render
RENDER_COMMAND=npx
RENDER_ARGS=tsx,src/cli.ts

SMTP_HOST=  # or your provider host
SMTP_PORT=           # or 465 if SSL
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=
SMTP_USE_SSL=
MAIL_FROM=
ADMIN_WAITLIST_EMAIL=
