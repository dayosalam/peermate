{
  "name": "peermate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "render": "npm --prefix render run render --",
    "video:test": "npm --prefix render run explain --",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "reset": "tsx src/scripts/reset.ts",
    "repair-session": "tsx src/scripts/repair-session.ts",
    "backfill-tenancy": "tsx src/scripts/backfill-tenancy.ts",
    "migrate-to-atlas": "tsx src/scripts/migrate-to-atlas.ts",
    "eval": "tsx src/scripts/eval.ts",
    "export-fixtures": "tsx src/scripts/export-fixtures.ts",
    "signups": "tsx src/scripts/list-signups.ts",
    "signups:prod": "node dist/scripts/list-signups.js",
    "hear": "tsx src/scripts/hear.ts",
    "dev:local": "DOTENV_CONFIG_PATH=.env.local tsx watch src/index.ts",
    "test:local": "DOTENV_CONFIG_PATH=.env.local tsx src/scripts/smoke.ts",
    "eval:local": "DOTENV_CONFIG_PATH=.env.local tsx src/scripts/eval.ts",
    "reset:local": "DOTENV_CONFIG_PATH=.env.local tsx src/scripts/reset.ts",
    "worker": "tsx src/render-main.ts",
    "worker:local": "DOTENV_CONFIG_PATH=.env.local tsx src/render-main.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "chromadb": "^3.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "langsmith": "^0.10.4",
    "mammoth": "^1.12.2",
    "minio": "^8.0.4",
    "mongodb": "^6.12.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.10",
    "openai": "^4.77.0",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "unpdf": "^1.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
